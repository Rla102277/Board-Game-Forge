# Development Environment Variables
# These are dummy values for local development only

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite for local dev, or use a local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gameforge

# Clerk Authentication
# Leave these empty or with REPLACE to use dev auth in development
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=REPLACE_ME

# AI Integrations - Using dummy URLs/keys for development
# These allow the server to start; actual AI features will fail gracefully
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=dummy_key_development

AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=dummy_key_development

AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_GEMINI_API_KEY=dummy_key_development

AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=dummy_key_development

# Gamma API (for design exports)
GAMMA_API_KEY=dummy_key_development

# Session Secret
SESSION_SECRET=dev_session_secret_change_this_in_production

# Other optional settings
# REPL_ID for Replit integration
