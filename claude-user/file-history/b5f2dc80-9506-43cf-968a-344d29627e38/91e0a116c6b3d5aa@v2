          {/* Template grid */}
          <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {TEMPLATES.filter((t) => templateCategory === "All" || t.category === templateCategory).map((t) => (
              <button
                key={t.key}
                onClick={() => generateFrom(t.key)}
