openapi: 3.1.0
info:
  # Do not change the title, if the title changes, the import paths will be broken
  title: Api
  version: 0.1.0
  description: GameForge API specification
servers:
  - url: /api
    description: Base API path
tags:
  - name: health
    description: Health operations
  - name: me
    description: Current user operations
  - name: admin
    description: Admin operations
  - name: projects
    description: Board game project operations
  - name: research
    description: Research item operations
  - name: entities
    description: Game entity operations
  - name: properties
    description: Entity property operations
  - name: rules
    description: Game rule operations
  - name: players
    description: Player archetype operations
  - name: notes
    description: Design note operations
  - name: tasks
    description: Task board operations
  - name: chat
    description: AI chat operations
  - name: dashboard
    description: Dashboard summary operations
  - name: assets
    description: Asset and card operations
  - name: simulator
    description: Game simulation operations
  - name: playtest
    description: Playtest session operations
  - name: feedback
    description: Public playtest feedback operations
  - name: storyboard
    description: Storyboard variant operations
  - name: balance
    description: Balance analysis operations
  - name: changelog
    description: Project changelog operations
  - name: export
    description: Export deliverable operations
paths:
  /healthz:
    get:
      operationId: healthCheck
      tags: [health]
      summary: Health check
      responses:
        "200":
          description: Healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthStatus"

  /me:
    get:
      operationId: getMe
      tags: [me]
      summary: Get current user profile
      responses:
        "200":
          description: Current user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Me"

  /me/ai-settings:
    get:
      operationId: getAiSettings
      tags: [me]
      responses:
        "200":
          description: AI provider settings
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AiProviderSettings"
    put:
      operationId: updateAiSettings
      tags: [me]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateAiSettingsBody"
      responses:
        "200":
          description: Updated settings
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AiProviderSettings"

  /admin/users:
    get:
      operationId: listAdminUsers
      tags: [admin]
      responses:
        "200":
          description: User list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/AdminUser"
        "403":
          $ref: "#/components/responses/Forbidden"

  /admin/users/{userId}:
    patch:
      operationId: updateAdminUser
      tags: [admin]
      parameters:
        - $ref: "#/components/parameters/UserId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateAdminUserBody"
      responses:
        "200":
          description: Updated user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AdminUser"
    delete:
      operationId: deleteAdminUser
      tags: [admin]
      parameters:
        - $ref: "#/components/parameters/UserId"
      responses:
        "204":
          description: Deleted

  /dashboard/summary:
    get:
      operationId: getDashboardSummary
      tags: [dashboard]
      responses:
        "200":
          description: Summary
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DashboardSummary"

  /dashboard/recent-activity:
    get:
      operationId: getRecentActivity
      tags: [dashboard]
      responses:
        "200":
          description: List of recent activity events
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ActivityEvent"

  /projects:
    get:
      operationId: listProjects
      tags: [projects]
      responses:
        "200":
          description: Project list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Project"
    post:
      operationId: createProject
      tags: [projects]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateProjectBody"
      responses:
        "201":
          description: Created project
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"

  /projects/{projectId}:
    get:
      operationId: getProject
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Project
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"
        "404":
          $ref: "#/components/responses/NotFound"
    patch:
      operationId: updateProject
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateProjectBody"
      responses:
        "200":
          description: Updated project
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"
    delete:
      operationId: deleteProject
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/stats:
    get:
      operationId: getProjectStats
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Project stats
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProjectStats"

  /projects/{projectId}/snapshots:
    get:
      operationId: listSnapshots
      tags: [projects]
      summary: List saved versions of a project
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: List of snapshots (newest first)
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ProjectSnapshot"
    post:
      operationId: createSnapshot
      tags: [projects]
      summary: Save the current project state as a new version
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateSnapshotBody"
      responses:
        "201":
          description: Created snapshot
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProjectSnapshot"

  /projects/{projectId}/snapshots/{snapshotId}:
    delete:
      operationId: deleteSnapshot
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - name: snapshotId
          in: path
          required: true
          schema:
            type: integer
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/snapshots/{snapshotId}/restore:
    post:
      operationId: restoreSnapshot
      tags: [projects]
      summary: Restore the project to a saved version (auto-saves current state first)
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - name: snapshotId
          in: path
          required: true
          schema:
            type: integer
      responses:
        "200":
          description: Restored
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RestoreSnapshotResponse"

  /projects/{projectId}/snapshots/{snapshotId}/fork:
    post:
      operationId: forkSnapshot
      tags: [projects]
      summary: Create a new project from a saved version
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - name: snapshotId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ForkSnapshotBody"
      responses:
        "201":
          description: New project created from snapshot
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"

  /projects/{projectId}/duplicate:
    post:
      operationId: duplicateProject
      tags: [projects]
      summary: Duplicate the current project state into a brand-new project
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DuplicateProjectBody"
      responses:
        "201":
          description: New project created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"

  /projects/{projectId}/complexity:
    post:
      operationId: computeComplexity
      tags: [projects]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Complexity score
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ComplexityScore"

  /projects/{projectId}/blueprint:
    post:
      operationId: generateBlueprint
      tags: [projects]
      summary: Stream a full AI Game Architect blueprint via SSE
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/GenerateBlueprintBody"
      responses:
        "200":
          description: SSE stream of blueprint chunks
          content:
            text/event-stream: {}

  /projects/{projectId}/ingest/text:
    post:
      operationId: ingestText
      tags: [projects]
      summary: Ingest pasted document text and produce an AI summary
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/IngestTextBody"
      responses:
        "200":
          description: Created research item with summary
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResearchItem"

  /projects/{projectId}/ingest/url:
    post:
      operationId: ingestUrl
      tags: [projects]
      summary: Fetch a URL and produce an AI summary
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/IngestUrlBody"
      responses:
        "200":
          description: Created research item with summary
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResearchItem"

  /projects/{projectId}/research:
    get:
      operationId: listResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Research list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ResearchItem"
    post:
      operationId: createResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateResearchBody"
      responses:
        "201":
          description: Created research
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResearchItem"

  /projects/{projectId}/research/{researchId}:
    patch:
      operationId: updateResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/ResearchId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateResearchBody"
      responses:
        "200":
          description: Updated research
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResearchItem"
    delete:
      operationId: deleteResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/ResearchId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/research/{researchId}/enhance:
    post:
      operationId: aiEnhanceResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/ResearchId"
      responses:
        "200":
          description: Enhanced research item
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResearchItem"

  /projects/{projectId}/research/ai-generate:
    post:
      operationId: aiGenerateResearch
      tags: [research]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AiGenerateBody"
      responses:
        "200":
          description: Generated research items
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ResearchItem"

  /projects/{projectId}/entities:
    get:
      operationId: listEntities
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Entity list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Entity"
    post:
      operationId: createEntity
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateEntityBody"
      responses:
        "201":
          description: Created entity
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Entity"

  /projects/{projectId}/entities/{entityId}:
    patch:
      operationId: updateEntity
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateEntityBody"
      responses:
        "200":
          description: Updated entity
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Entity"
    delete:
      operationId: deleteEntity
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/entities/ai-generate:
    post:
      operationId: aiGenerateEntities
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AiGenerateBody"
      responses:
        "200":
          description: Generated entities
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Entity"

  /projects/{projectId}/entities/{entityId}/enhance:
    post:
      operationId: aiEnhanceEntity
      tags: [entities]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
      responses:
        "200":
          description: Structured AI enhancement preview (not yet applied)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/EntityEnhanceSuggestion"

  /projects/{projectId}/entity-properties:
    get:
      operationId: listProjectEntityProperties
      tags: [properties]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Flat list of all entity properties for the project
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/EntityProperty"

  /projects/{projectId}/entities/{entityId}/properties:
    get:
      operationId: listEntityProperties
      tags: [properties]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
      responses:
        "200":
          description: Property list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/EntityProperty"
    post:
      operationId: createEntityProperty
      tags: [properties]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateEntityPropertyBody"
      responses:
        "201":
          description: Created property
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/EntityProperty"

  /projects/{projectId}/entities/{entityId}/properties/{propertyId}:
    patch:
      operationId: updateEntityProperty
      tags: [properties]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
        - $ref: "#/components/parameters/PropertyId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateEntityPropertyBody"
      responses:
        "200":
          description: Updated property
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/EntityProperty"
    delete:
      operationId: deleteEntityProperty
      tags: [properties]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/EntityId"
        - $ref: "#/components/parameters/PropertyId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/rules:
    get:
      operationId: listRules
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Rule list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Rule"
    post:
      operationId: createRule
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateRuleBody"
      responses:
        "201":
          description: Created rule
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Rule"

  /projects/{projectId}/rules/{ruleId}:
    patch:
      operationId: updateRule
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/RuleId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateRuleBody"
      responses:
        "200":
          description: Updated rule
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Rule"
    delete:
      operationId: deleteRule
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/RuleId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/rules/ai-generate:
    post:
      operationId: aiGenerateRules
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AiGenerateBody"
      responses:
        "200":
          description: Generated rules
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Rule"

  /projects/{projectId}/rules/{ruleId}/enhance:
    post:
      operationId: aiEnhanceRule
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/RuleId"
      responses:
        "200":
          description: Structured AI enhancement preview (not yet applied)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RuleEnhanceSuggestion"

  /projects/{projectId}/rules/conflict-check:
    post:
      operationId: conflictCheckRules
      tags: [rules]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Conflict report
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ConflictReport"

  /projects/{projectId}/players:
    get:
      operationId: listPlayers
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Player list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Player"
    post:
      operationId: createPlayer
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreatePlayerBody"
      responses:
        "201":
          description: Created player
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Player"

  /projects/{projectId}/players/{playerId}:
    patch:
      operationId: updatePlayer
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/PlayerId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdatePlayerBody"
      responses:
        "200":
          description: Updated player
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Player"
    delete:
      operationId: deletePlayer
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/PlayerId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/players/ai-generate:
    post:
      operationId: aiGeneratePlayers
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AiGenerateBody"
      responses:
        "200":
          description: Generated players
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Player"

  /projects/{projectId}/players/{playerId}/enhance:
    post:
      operationId: aiEnhancePlayer
      tags: [players]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/PlayerId"
      responses:
        "200":
          description: Enhanced player
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Player"

  /projects/{projectId}/notes:
    get:
      operationId: listNotes
      tags: [notes]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      responses:
        "200":
          description: Note list
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Note"
    post:
      operationId: createNote
      tags: [notes]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateNoteBody"
      responses:
        "201":
          description: Created note
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Note"

  /projects/{projectId}/notes/{noteId}/enhance:
    post:
      operationId: aiEnhanceNote
      tags: [notes]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/NoteId"
      responses:
        "200":
          description: Enhanced note
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Note"

  /projects/{projectId}/notes/{noteId}:
    patch:
      operationId: updateNote
      tags: [notes]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/NoteId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateNoteBody"
      responses:
        "200":
          description: Updated note
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Note"
    delete:
      operationId: deleteNote
      tags: [notes]
      parameters:
        - $ref: "#/components/parameters/ProjectId"
        - $ref: "#/components/parameters/NoteId"
      responses:
        "204":
          description: Deleted

  /projects/{projectId}/tasks:
    get:
      operationId: listTasks
      tags: [tasks]
